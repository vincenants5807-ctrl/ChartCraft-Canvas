<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChartCraft - 数据可视化图表生成器</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
            background: #0a0e17;
            color: #c8d0dc;
            min-height: 100vh;
        }
        header {
            text-align: center; padding: 36px 20px 20px;
        }
        header h1 { font-size: 32px; font-weight: 800; }
        header h1 span { background: linear-gradient(135deg, #f97316, #ef4444, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        header p { color: #4b5563; font-size: 14px; margin-top: 4px; }

        .container { max-width: 1100px; margin: 0 auto; padding: 0 20px 40px; }

        .main-grid { display: grid; grid-template-columns: 1fr 360px; gap: 20px; }

        /* 图表预览 */
        .chart-card {
            background: #111827;
            border: 1px solid #1f2937;
            border-radius: 20px;
            padding: 28px;
            position: relative;
        }
        .chart-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 20px;
        }
        .chart-title-input {
            font-size: 18px; font-weight: 700; background: transparent;
            border: none; color: white; outline: none; border-bottom: 1px solid transparent;
        }
        .chart-title-input:focus { border-bottom-color: #f97316; }
        .chart-btns { display: flex; gap: 4px; }
        .ch-btn {
            padding: 6px 12px; background: #1f2937; border: 1px solid #374151;
            color: #9ca3af; border-radius: 6px; cursor: pointer; font-size: 11px; transition: 0.2s;
        }
        .ch-btn:hover { color: white; background: #374151; }
        #chartCanvas {
            width: 100%;
            height: 420px;
            border-radius: 12px;
            background: #0d1117;
        }

        /* 右侧面板 */
        .panel { display: flex; flex-direction: column; gap: 16px; }
        .panel-card {
            background: #111827;
            border: 1px solid #1f2937;
            border-radius: 16px;
            padding: 20px;
        }
        .panel-title { font-size: 14px; font-weight: 600; margin-bottom: 14px; display: flex; align-items: center; gap: 6px; }

        /* 图表类型 */
        .type-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
        .type-item {
            padding: 12px 8px;
            background: #0d1117;
            border: 1px solid #1f2937;
            border-radius: 10px;
            cursor: pointer; text-align: center; font-size: 12px;
            transition: 0.2s;
        }
        .type-item:hover { border-color: #374151; }
        .type-item.active { border-color: #f97316; color: #f97316; background: rgba(249,115,22,0.06); }
        .type-icon { font-size: 22px; margin-bottom: 4px; }

        /* 数据编辑 */
        .data-table { width: 100%; border-collapse: collapse; }
        .data-table th, .data-table td {
            padding: 8px; text-align: left; border-bottom: 1px solid #1f2937;
        }
        .data-table th { font-size: 11px; color: #6b7280; font-weight: 500; }
        .data-cell {
            width: 100%; padding: 6px 8px;
            background: #0d1117; border: 1px solid #1f2937;
            color: white; border-radius: 4px; font-size: 12px; outline: none;
        }
        .data-cell:focus { border-color: #f97316; }
        .data-color {
            width: 28px; height: 28px; border: none; border-radius: 6px;
            cursor: pointer; background: none;
        }
        .data-del {
            background: none; border: none; color: #374151; cursor: pointer;
            font-size: 14px; transition: 0.2s;
        }
        .data-del:hover { color: #ef4444; }
        .add-row-btn {
            width: 100%; padding: 8px;
            background: transparent; border: 1px dashed #1f2937;
            color: #4b5563; border-radius: 8px; cursor: pointer;
            font-size: 12px; margin-top: 8px; transition: 0.2s;
        }
        .add-row-btn:hover { border-color: #374151; color: #9ca3af; }

        /* 样式设置 */
        .style-row {
            display: flex; justify-content: space-between; align-items: center;
            padding: 8px 0; border-bottom: 1px solid #0d1117;
        }
        .style-label { font-size: 12px; color: #6b7280; }
        .style-toggle {
            width: 36px; height: 20px; background: #1f2937;
            border-radius: 10px; cursor: pointer; position: relative; transition: 0.3s;
            border: 1px solid #374151;
        }
        .style-toggle.on { background: #f97316; border-color: #f97316; }
        .style-toggle::after {
            content: ''; position: absolute; top: 2px; left: 2px;
            width: 14px; height: 14px; background: white;
            border-radius: 50%; transition: 0.3s;
        }
        .style-toggle.on::after { left: 18px; }
        .style-slider {
            width: 80px; -webkit-appearance: none;
            height: 4px; background: #1f2937; border-radius: 2px; outline: none;
        }
        .style-slider::-webkit-slider-thumb {
            -webkit-appearance: none; width: 14px; height: 14px;
            border-radius: 50%; background: #f97316; cursor: pointer;
        }

        /* 预设数据 */
        .preset-row { display: flex; gap: 4px; flex-wrap: wrap; }
        .preset-btn {
            padding: 6px 12px; background: rgba(255,255,255,0.03);
            border: 1px solid #1f2937; color: #6b7280;
            border-radius: 16px; cursor: pointer; font-size: 11px; transition: 0.2s;
        }
        .preset-btn:hover { color: #d1d5db; border-color: #374151; }

        .toast {
            position: fixed; bottom: 30px; left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: #111827; border: 1px solid #1f2937;
            color: white; padding: 10px 24px; border-radius: 12px;
            font-size: 13px; opacity: 0; transition: 0.3s; z-index: 200;
        }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

        @media (max-width: 768px) {
            .main-grid { grid-template-columns: 1fr; }
            #chartCanvas { height: 300px; }
        }
    </style>
</head>
<body>
    <header>
        <h1>📊 Chart<span>Craft</span></h1>
        <p>零依赖 Canvas 数据可视化图表生成器</p>
    </header>

    <div class="container">
        <div class="main-grid">
            <!-- 图表 -->
            <div class="chart-card">
                <div class="chart-header">
                    <input class="chart-title-input" id="chartTitle" value="月度销售数据" oninput="drawChart()">
                    <div class="chart-btns">
                        <button class="ch-btn" onclick="downloadPNG()">🖼 PNG</button>
                        <button class="ch-btn" onclick="downloadSVG()">💾 SVG</button>
                        <button class="ch-btn" onclick="copyData()">📋 复制数据</button>
                    </div>
                </div>
                <canvas id="chartCanvas"></canvas>
            </div>

            <!-- 面板 -->
            <div class="panel">
                <!-- 图表类型 -->
                <div class="panel-card">
                    <div class="panel-title">📈 图表类型</div>
                    <div class="type-grid" id="typeGrid"></div>
                </div>

                <!-- 数据编辑 -->
                <div class="panel-card">
                    <div class="panel-title">📝 数据编辑</div>
                    <div style="max-height:280px;overflow-y:auto;">
                        <table class="data-table" id="dataTable"></table>
                    </div>
                    <button class="add-row-btn" onclick="addDataRow()">＋ 添加数据行</button>
                </div>

                <!-- 预设 -->
                <div class="panel-card">
                    <div class="panel-title">✨ 示例数据</div>
                    <div class="preset-row">
                        <button class="preset-btn" onclick="loadPreset('sales')">📊 销售数据</button>
                        <button class="preset-btn" onclick="loadPreset('weather')">🌡 气温</button>
                        <button class="preset-btn" onclick="loadPreset('scores')">📚 成绩</button>
                        <button class="preset-btn" onclick="loadPreset('traffic')">🌐 流量</button>
                        <button class="preset-btn" onclick="loadPreset('random')">🎲 随机</button>
                    </div>
                </div>

                <!-- 样式 -->
                <div class="panel-card">
                    <div class="panel-title">🎨 样式设置</div>
                    <div class="style-row">
                        <span class="style-label">显示网格</span>
                        <div class="style-toggle on" id="togGrid" onclick="toggleStyle('showGrid')"></div>
                    </div>
                    <div class="style-row">
                        <span class="style-label">显示数值</span>
                        <div class="style-toggle on" id="togValues" onclick="toggleStyle('showValues')"></div>
                    </div>
                    <div class="style-row">
                        <span class="style-label">动画效果</span>
                        <div class="style-toggle on" id="togAnim" onclick="toggleStyle('animate')"></div>
                    </div>
                    <div class="style-row">
                        <span class="style-label">圆角</span>
                        <input type="range" class="style-slider" id="radiusSlider" min="0" max="20" value="6" oninput="chartStyle.radius=this.value;drawChart();">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <script>
        // ========== 状态 ==========
        const CHART_TYPES = [
            { id: 'bar', icon: '📊', name: '柱状图' },
            { id: 'line', icon: '📈', name: '折线图' },
            { id: 'pie', icon: '🥧', name: '饼图' },
            { id: 'doughnut', icon: '🍩', name: '环形图' },
            { id: 'area', icon: '📉', name: '面积图' },
            { id: 'hbar', icon: '📊', name: '横向柱状' },
            { id: 'radar', icon: '🕸', name: '雷达图' },
            { id: 'scatter', icon: '⚬', name: '散点图' },
            { id: 'polar', icon: '◎', name: '极区图' }
        ];

        const COLORS = ['#f97316','#3b82f6','#10b981','#ef4444','#8b5cf6','#ec4899','#06b6d4','#f59e0b','#84cc16','#6366f1'];

        let chartType = 'bar';
        let chartData = [
            { label: '一月', value: 65, color: COLORS[0] },
            { label: '二月', value: 45, color: COLORS[1] },
            { label: '三月', value: 80, color: COLORS[2] },
            { label: '四月', value: 55, color: COLORS[3] },
            { label: '五月', value: 90, color: COLORS[4] },
            { label: '六月', value: 72, color: COLORS[5] },
        ];

        let chartStyle = {
            showGrid: true,
            showValues: true,
            animate: true,
            radius: 6,
        };

        let animProgress = 0;
        let animFrame = null;

        // ========== 类型选择 ==========
        function renderTypeGrid() {
            document.getElementById('typeGrid').innerHTML = CHART_TYPES.map(t =>
                `<div class="type-item ${chartType===t.id?'active':''}" onclick="setType('${t.id}')">
                    <div class="type-icon">${t.icon}</div>${t.name}
                </div>`
            ).join('');
        }

        function setType(type) {
            chartType = type;
            renderTypeGrid();
            animateChart();
        }

        // ========== 数据表格 ==========
        function renderDataTable() {
            const table = document.getElementById('dataTable');
            table.innerHTML = `
                <thead><tr><th>标签</th><th>数值</th><th>颜色</th><th></th></tr></thead>
                <tbody>
                    ${chartData.map((d, i) => `
                        <tr>
                            <td><input class="data-cell" value="${d.label}" oninput="chartData[${i}].label=this.value;drawChart();"></td>
                            <td><input class="data-cell" type="number" value="${d.value}" oninput="chartData[${i}].value=Number(this.value);drawChart();"></td>
                            <td><input type="color" class="data-color" value="${d.color}" oninput="chartData[${i}].color=this.value;drawChart();"></td>
                            <td>${chartData.length > 2 ? `<button class="data-del" onclick="removeDataRow(${i})">×</button>` : ''}</td>
                        </tr>
                    `).join('')}
                </tbody>
            `;
        }

        function addDataRow() {
            chartData.push({
                label: '新项' + (chartData.length + 1),
                value: Math.floor(Math.random() * 80 + 20),
                color: COLORS[chartData.length % COLORS.length]
            });
            renderDataTable();
            animateChart();
        }

        function removeDataRow(i) {
            chartData.splice(i, 1);
            renderDataTable();
            animateChart();
        }

        // ========== 预设 ==========
        const PRESETS = {
            sales: { title: '月度销售数据', data: [
                {label:'一月',value:65},{label:'二月',value:45},{label:'三月',value:80},{label:'四月',value:55},{label:'五月',value:90},{label:'六月',value:72}
            ]},
            weather: { title: '城市月均温度 (°C)', data: [
                {label:'北京',value:12},{label:'上海',value:16},{label:'广州',value:22},{label:'成都',value:17},{label:'哈尔滨',value:4},{label:'昆明',value:15}
            ]},
            scores: { title: '学科成绩分布', data: [
                {label:'语文',value:88},{label:'数学',value:95},{label:'英语',value:82},{label:'物理',value:91},{label:'化学',value:86},{label:'生物',value:79}
            ]},
            traffic: { title: '网站日均流量 (万)', data: [
                {label:'周一',value:42},{label:'周二',value:48},{label:'周三',value:55},{label:'周四',value:51},{label:'周五',value:60},{label:'周六',value:38},{label:'周日',value:32}
            ]},
            random: { title: '随机数据', data: [] }
        };

        function loadPreset(name) {
            const p = PRESETS[name];
            if (name === 'random') {
                p.data = Array.from({length: 5+Math.floor(Math.random()*4)}, (_, i) => ({
                    label: '项' + (i+1), value: Math.floor(Math.random()*90+10)
                }));
            }
            document.getElementById('chartTitle').value = p.title;
            chartData = p.data.map((d, i) => ({ ...d, color: COLORS[i % COLORS.length] }));
            renderDataTable();
            animateChart();
            showToast(`✨ 已加载: ${p.title}`);
        }

        // ========== 样式开关 ==========
        function toggleStyle(key) {
            chartStyle[key] = !chartStyle[key];
            const togMap = { showGrid: 'togGrid', showValues: 'togValues', animate: 'togAnim' };
            if (togMap[key]) document.getElementById(togMap[key]).classList.toggle('on', chartStyle[key]);
            drawChart();
        }

        // ========== 动画 ==========
        function animateChart() {
            if (!chartStyle.animate) { animProgress = 1; drawChart(); return; }
            animProgress = 0;
            if (animFrame) cancelAnimationFrame(animFrame);
            function step() {
                animProgress += 0.04;
                if (animProgress >= 1) { animProgress = 1; drawChart(); return; }
                drawChart();
                animFrame = requestAnimationFrame(step);
            }
            step();
        }

        // ========== 绘图引擎 ==========
        function drawChart() {
            const canvas = document.getElementById('chartCanvas');
            const dpr = window.devicePixelRatio || 1;
            canvas.width = canvas.offsetWidth * dpr;
            canvas.height = canvas.offsetHeight * dpr;
            const ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);
            const W = canvas.offsetWidth;
            const H = canvas.offsetHeight;
            ctx.clearRect(0, 0, W, H);

            if (chartData.length === 0) return;

            const p = animProgress;
            const title = document.getElementById('chartTitle').value;

            // 标题
            ctx.fillStyle = '#e5e7eb';
            ctx.font = 'bold 16px "Segoe UI", sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(title, W / 2, 28);

            const margin = { top: 50, right: 30, bottom: 50, left: 60 };
            const cw = W - margin.left - margin.right;
            const ch = H - margin.top - margin.bottom;

            if (['bar','line','area','scatter'].includes(chartType)) {
                drawCartesian(ctx, W, H, margin, cw, ch, p);
            } else if (chartType === 'hbar') {
                drawHBar(ctx, W, H, margin, cw, ch, p);
            } else if (['pie','doughnut','polar'].includes(chartType)) {
                drawCircular(ctx, W, H, p);
            } else if (chartType === 'radar') {
                drawRadar(ctx, W, H, p);
            }
        }

        function drawCartesian(ctx, W, H, margin, cw, ch, p) {
            const maxVal = Math.max(...chartData.map(d => d.value)) * 1.15;
            const n = chartData.length;

            // 网格
            if (chartStyle.showGrid) {
                ctx.strokeStyle = '#1f2937';
                ctx.lineWidth = 0.5;
                for (let i = 0; i <= 5; i++) {
                    const y = margin.top + ch - (ch / 5) * i;
                    ctx.beginPath(); ctx.moveTo(margin.left, y); ctx.lineTo(margin.left + cw, y); ctx.stroke();
                    ctx.fillStyle = '#4b5563'; ctx.font = '11px monospace'; ctx.textAlign = 'right';
                    ctx.fillText(Math.round(maxVal / 5 * i), margin.left - 8, y + 4);
                }
            }

            // 柱状图
            if (chartType === 'bar') {
                const barW = Math.min(60, cw / n * 0.6);
                const gap = cw / n;
                chartData.forEach((d, i) => {
                    const barH = (d.value / maxVal) * ch * p;
                    const x = margin.left + gap * i + (gap - barW) / 2;
                    const y = margin.top + ch - barH;
                    const r = Math.min(chartStyle.radius, barW / 2, barH);

                    ctx.fillStyle = d.color;
                    ctx.beginPath();
                    ctx.moveTo(x, y + r);
                    ctx.arcTo(x, y, x + r, y, r);
                    ctx.arcTo(x + barW, y, x + barW, y + r, r);
                    ctx.lineTo(x + barW, margin.top + ch);
                    ctx.lineTo(x, margin.top + ch);
                    ctx.closePath();
                    ctx.fill();

                    // 标签
                    ctx.fillStyle = '#9ca3af'; ctx.font = '12px sans-serif'; ctx.textAlign = 'center';
                    ctx.fillText(d.label, x + barW / 2, margin.top + ch + 20);

                    // 数值
                    if (chartStyle.showValues && p > 0.8) {
                        ctx.fillStyle = '#e5e7eb'; ctx.font = 'bold 12px monospace';
                        ctx.fillText(d.value, x + barW / 2, y - 8);
                    }
                });
            }

            // 折线图 / 面积图
            if (chartType === 'line' || chartType === 'area') {
                const gap = cw / (n - 1 || 1);
                const points = chartData.map((d, i) => ({
                    x: margin.left + gap * i,
                    y: margin.top + ch - (d.value / maxVal) * ch * p
                }));

                if (chartType === 'area') {
                    ctx.beginPath();
                    ctx.moveTo(points[0].x, margin.top + ch);
                    points.forEach(pt => ctx.lineTo(pt.x, pt.y));
                    ctx.lineTo(points[points.length-1].x, margin.top + ch);
                    ctx.closePath();
                    const grad = ctx.createLinearGradient(0, margin.top, 0, margin.top + ch);
                    grad.addColorStop(0, chartData[0].color + '40');
                    grad.addColorStop(1, chartData[0].color + '05');
                    ctx.fillStyle = grad;
                    ctx.fill();
                }

                ctx.strokeStyle = chartData[0].color;
                ctx.lineWidth = 2.5;
                ctx.lineJoin = 'round';
                ctx.beginPath();
                points.forEach((pt, i) => i === 0 ? ctx.moveTo(pt.x, pt.y) : ctx.lineTo(pt.x, pt.y));
                ctx.stroke();

                points.forEach((pt, i) => {
                    ctx.fillStyle = '#0a0e17';
                    ctx.beginPath(); ctx.arc(pt.x, pt.y, 5, 0, Math.PI*2); ctx.fill();
                    ctx.fillStyle = chartData[i].color;
                    ctx.beginPath(); ctx.arc(pt.x, pt.y, 3.5, 0, Math.PI*2); ctx.fill();

                    ctx.fillStyle = '#9ca3af'; ctx.font = '12px sans-serif'; ctx.textAlign = 'center';
                    ctx.fillText(chartData[i].label, pt.x, margin.top + ch + 20);

                    if (chartStyle.showValues && p > 0.8) {
                        ctx.fillStyle = '#e5e7eb'; ctx.font = 'bold 12px monospace';
                        ctx.fillText(chartData[i].value, pt.x, pt.y - 12);
                    }
                });
            }

            // 散点图
            if (chartType === 'scatter') {
                const gap = cw / (n - 1 || 1);
                chartData.forEach((d, i) => {
                    const x = margin.left + gap * i;
                    const y = margin.top + ch - (d.value / maxVal) * ch * p;
                    const r = 6 * p;

                    ctx.fillStyle = d.color + '30';
                    ctx.beginPath(); ctx.arc(x, y, r * 2, 0, Math.PI*2); ctx.fill();
                    ctx.fillStyle = d.color;
                    ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI*2); ctx.fill();

                    ctx.fillStyle = '#9ca3af'; ctx.font = '12px sans-serif'; ctx.textAlign = 'center';
                    ctx.fillText(d.label, x, margin.top + ch + 20);
                });
            }
        }

        function drawHBar(ctx, W, H, margin, cw, ch, p) {
            const maxVal = Math.max(...chartData.map(d => d.value)) * 1.15;
            const n = chartData.length;
            const barH = Math.min(36, ch / n * 0.6);
            const gap = ch / n;

            chartData.forEach((d, i) => {
                const barW = (d.value / maxVal) * cw * p;
                const y = margin.top + gap * i + (gap - barH) / 2;
                const r = Math.min(chartStyle.radius, barH / 2, barW);

                ctx.fillStyle = d.color;
                ctx.beginPath();
                ctx.moveTo(margin.left, y);
                ctx.lineTo(margin.left + barW - r, y);
                ctx.arcTo(margin.left + barW, y, margin.left + barW, y + r, r);
                ctx.arcTo(margin.left + barW, y + barH, margin.left + barW - r, y + barH, r);
                ctx.lineTo(margin.left, y + barH);
                ctx.closePath();
                ctx.fill();

                ctx.fillStyle = '#9ca3af'; ctx.font = '12px sans-serif'; ctx.textAlign = 'right';
                ctx.fillText(d.label, margin.left - 8, y + barH / 2 + 4);

                if (chartStyle.showValues && p > 0.8) {
                    ctx.fillStyle = '#e5e7eb'; ctx.font = 'bold 12px monospace'; ctx.textAlign = 'left';
                    ctx.fillText(d.value, margin.left + barW + 8, y + barH / 2 + 4);
                }
            });
        }

        function drawCircular(ctx, W, H, p) {
            const cx = W / 2, cy = H / 2 + 10;
            const r = Math.min(W, H) * 0.32;
            const total = chartData.reduce((s, d) => s + d.value, 0);
            let startAngle = -Math.PI / 2;

            chartData.forEach((d, i) => {
                const sliceAngle = (d.value / total) * Math.PI * 2 * p;
                const endAngle = startAngle + sliceAngle;
                const innerR = chartType === 'doughnut' ? r * 0.55 : (chartType === 'polar' ? r * (d.value / Math.max(...chartData.map(x=>x.value))) : 0);

                ctx.fillStyle = d.color;
                ctx.beginPath();
                if (chartType === 'polar') {
                    const pr = r * (d.value / Math.max(...chartData.map(x=>x.value))) * p;
                    ctx.moveTo(cx, cy);
                    ctx.arc(cx, cy, pr, startAngle, endAngle);
                } else {
                    ctx.arc(cx, cy, r, startAngle, endAngle);
                    if (chartType === 'doughnut') {
                        ctx.arc(cx, cy, innerR, endAngle, startAngle, true);
                    } else {
                        ctx.lineTo(cx, cy);
                    }
                }
                ctx.closePath();
                ctx.fill();

                // 标签
                if (p > 0.8 && chartStyle.showValues) {
                    const mid = startAngle + sliceAngle / 2;
                    const lr = r * (chartType === 'doughnut' ? 0.78 : 0.7);
                    const lx = cx + Math.cos(mid) * lr;
                    const ly = cy + Math.sin(mid) * lr;
                    ctx.fillStyle = '#fff';
                    ctx.font = 'bold 12px sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText(`${d.label}`, lx, ly - 6);
                    ctx.font = '11px monospace';
                    ctx.fillText(`${Math.round(d.value/total*100)}%`, lx, ly + 10);
                }

                startAngle = endAngle;
            });
        }

        function drawRadar(ctx, W, H, p) {
            const cx = W / 2, cy = H / 2 + 10;
            const r = Math.min(W, H) * 0.32;
            const n = chartData.length;
            const maxVal = Math.max(...chartData.map(d => d.value));
            const angleStep = (Math.PI * 2) / n;

            // 网格
            for (let ring = 1; ring <= 4; ring++) {
                ctx.strokeStyle = '#1f2937'; ctx.lineWidth = 0.5;
                ctx.beginPath();
                for (let i = 0; i <= n; i++) {
                    const a = -Math.PI / 2 + angleStep * i;
                    const rr = r * ring / 4;
                    const x = cx + Math.cos(a) * rr;
                    const y = cy + Math.sin(a) * rr;
                    i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
                }
                ctx.closePath(); ctx.stroke();
            }

            // 轴线
            chartData.forEach((d, i) => {
                const a = -Math.PI / 2 + angleStep * i;
                ctx.strokeStyle = '#1f2937'; ctx.lineWidth = 0.5;
                ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + Math.cos(a) * r, cy + Math.sin(a) * r); ctx.stroke();
                ctx.fillStyle = '#9ca3af'; ctx.font = '12px sans-serif'; ctx.textAlign = 'center';
                ctx.fillText(d.label, cx + Math.cos(a) * (r + 18), cy + Math.sin(a) * (r + 18) + 4);
            });

            // 数据
            ctx.beginPath();
            chartData.forEach((d, i) => {
                const a = -Math.PI / 2 + angleStep * i;
                const vr = (d.value / maxVal) * r * p;
                const x = cx + Math.cos(a) * vr;
                const y = cy + Math.sin(a) * vr;
                i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
            });
            ctx.closePath();
            ctx.fillStyle = COLORS[0] + '25';
            ctx.fill();
            ctx.strokeStyle = COLORS[0];
            ctx.lineWidth = 2;
            ctx.stroke();

            // 点
            chartData.forEach((d, i) => {
                const a = -Math.PI / 2 + angleStep * i;
                const vr = (d.value / maxVal) * r * p;
                ctx.fillStyle = COLORS[0];
                ctx.beginPath(); ctx.arc(cx + Math.cos(a) * vr, cy + Math.sin(a) * vr, 4, 0, Math.PI * 2); ctx.fill();
            });
        }

        // ========== 导出 ==========
        function downloadPNG() {
            const canvas = document.getElementById('chartCanvas');
            const a = document.createElement('a');
            a.download = 'chart.png';
            a.href = canvas.toDataURL('image/png');
            a.click();
            showToast('🖼 PNG 已下载');
        }

        function downloadSVG() {
            showToast('💾 SVG 导出开发中');
        }

        function copyData() {
            const text = chartData.map(d => `${d.label}\t${d.value}`).join('\n');
            navigator.clipboard.writeText(text).then(() => showToast('📋 数据已复制'));
        }

        // ========== 工具 ==========
        function showToast(msg) {
            const t = document.getElementById('toast');
            t.textContent = msg; t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2200);
        }

        // 窗口resize
        window.addEventListener('resize', drawChart);

        // 初始化
        renderTypeGrid();
        renderDataTable();
        animateChart();
    </script>
</body>
</html>
